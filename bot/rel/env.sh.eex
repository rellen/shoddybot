#!/bin/sh
# Sourced by the release scripts before they start the VM. See
# `mix help release` for the variables that can be set here.

# Builds that drop the generated COOKIE file from the release (the Nix
# package does, so the cookie does not end up world-readable in the store)
# still need a cookie for the scripts to start. Use a random one for this
# boot unless RELEASE_COOKIE is set. Set RELEASE_COOKIE yourself if you want
# to attach a remote shell.
if [ -z "${RELEASE_COOKIE:-}" ] && [ ! -f "$RELEASE_ROOT/releases/COOKIE" ]; then
  RELEASE_COOKIE="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
  export RELEASE_COOKIE
fi
